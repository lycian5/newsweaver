POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n
N8N_HOST=n8n.coanews.co.kr
N8N_VERSION=2.30.7
WEBHOOK_URL=https://n8n.coanews.co.kr/
N8N_ENCRYPTION_KEY=
EXECUTIONS_DATA_MAX_AGE=336

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
OPENAI_API_KEY=
OPENAI_MODEL_CLASSIFY=gpt-5.4-nano
OPENAI_MODEL_SUGGEST=gpt-5-mini
OPENAI_MODEL_DRAFT=gpt-5-mini
OPENAI_MODEL_PREMIUM=gpt-5.4-mini
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
SLACK_WEBHOOK_URL=
AGENT_REACH_NOTIFY_SLACK=true

AGENT_REACH_WEBHOOK_SECRET=
AGENT_REACH_RUNNER_SECRET=
AGENT_REACH_RUNNER_HOST=0.0.0.0
AGENT_REACH_RUNNER_PORT=8787
AGENT_REACH_RUNNER_URL=http://host.docker.internal:8787/run
# Stable defaults. Add youtube after YOUTUBE_API_KEY setup, github after gh/GH_TOKEN authentication, and reddit after OAuth setup.
AGENT_REACH_SOURCES=exa,official,rss
AGENT_REACH_OFFICIAL_RESULTS=3
AGENT_REACH_RSS_RESULTS=8
AGENT_REACH_LIMIT_KEYWORDS=54
AGENT_REACH_CORE_KEYWORDS=12
AGENT_REACH_ROTATING_KEYWORDS=42
AGENT_REACH_EXA_RESULTS=3
AGENT_REACH_EXA_DAILY_REQUEST_LIMIT=36
AGENT_REACH_EXA_MONTHLY_BUDGET_USD=8
# VPS only. Uses Exa's direct Search API and records usage in the VPS data directory.
EXA_API_KEY=
AGENT_REACH_YOUTUBE_RESULTS=3
# VPS only. Uses the official YouTube Data API when set; otherwise yt-dlp is used.
YOUTUBE_API_KEY=
AGENT_REACH_GITHUB_RESULTS=5
AGENT_REACH_REDDIT_RESULTS=5
AGENT_REACH_TIMEOUT_MS=45000
AGENT_REACH_JINA_ENRICH=false
AGENT_REACH_RSS_FEEDS=
# VPS only. Register an approved read-only Reddit API app and keep these values out of Vercel.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=script:coa-newsweaver:v1.0 (by /u/lycian57)

BACKUP_ENCRYPTION_PASSWORD=
BACKUP_RETENTION_DAYS=7
